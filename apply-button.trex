<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.example.applybutton" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name">Apply Updates Button</name>
    <description>Pauses updates and applies them only on click</description>
    <author name="Your Name" email="your.email@example.com" organization="Your Org" website="https://example.com"/>
    <min-api-version>1.1</min-api-version>
    <source-location>
 <url>https://ohomri-rgb.github.io/kpi-extension/indexnew.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Apply Updates Button</text>
    </resource>
  </resources>
</manifest>