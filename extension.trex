
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns="http://www.tableau.com/xml/extension_manifest" manifest-version="1.0">
  <worksheet-extension id="com.example.streamgraph.viz" extension-version="1.0.0">
    <default-locale>en-US</default-locale>
    <name>D3 Streamgraph</name>
    <description>Custom Streamgraph for Tableau</description>
    <author name="Gemini" email="support@example.com" organization="AI" website="https://example.com"/>
    <min-api-version>2.0</min-api-version>
    <source-location>
    <url>https://ohomri-rgb.github.io/kpi-extension/index.html</url>
    </source-location>
    <icon></icon>
    <capabilities>
      <visual-extension/>
    </capabilities>
  </worksheet-extension>
</manifest>
